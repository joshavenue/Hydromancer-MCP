{
  "name": "hydromancer-mcp",
  "version": "0.2.1",
  "mcpName": "io.github.joshavenue/hydromancer-mcp",
  "description": "MCP server for the Hydromancer Hyperliquid API: ask your AI about wallets, positions, top traders, markets and liquidations in plain English",
  "type": "module",
  "license": "MIT",
  "author": "Hydromancer",
  "homepage": "https://hydromancer.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshavenue/Hydromancer-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/joshavenue/Hydromancer-MCP/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hyperliquid",
    "hydromancer",
    "trading-data",
    "ai-tools"
  ],
  "bin": {
    "hydromancer-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.9"
  }
}
